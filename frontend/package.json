{
  "name": "lexigo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:lesson": "playwright test e2e/lesson-flow.spec.ts",
    "test:e2e:a11y": "playwright test e2e/accessibility-keyboard.spec.ts e2e/route-focus-management.spec.ts",
    "test:e2e:ui": "playwright test e2e/ui-ownership.spec.ts e2e/account-hydration.spec.ts e2e/auth-flow.spec.ts e2e/async-states.spec.ts e2e/accessibility-keyboard.spec.ts e2e/route-focus-management.spec.ts",
    "test:e2e:pwa": "playwright test e2e/dictionary-pwa.spec.ts --project=ios-webkit"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.10",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0"
  }
}
