{
  "openapi": "3.1.0",
  "info": {
    "title": "LexiGo Scenario Lessons API",
    "version": "0.14.0",
    "description": "Bounded machine-readable contract for authenticated Scenario Lessons routes and their Progress projection. The server owns the review target, objective judgement, completion evidence and recommendation ordering; clients submit production evidence and optional timing metadata only."
  },
  "servers": [{ "url": "http://localhost:8080", "description": "local" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/progress": {
      "get": {
        "operationId": "getScenarioProgressProjection",
        "tags": ["scenarios", "progress"],
        "summary": "Get learning progress with the server-owned Scenario completion and recommendation projection.",
        "parameters": [{ "$ref": "#/components/parameters/TimezoneOffsetMinutes" }],
        "responses": {
          "200": { "description": "Learning progress containing the authoritative Scenario projection.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioProgressEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "operationId": "listScenarios",
        "tags": ["scenarios"],
        "summary": "List the active technical Scenario catalog.",
        "responses": {
          "200": { "description": "Active Scenario catalog.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioCatalog" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenarios/{slug}": {
      "parameters": [{ "$ref": "#/components/parameters/ScenarioSlug" }],
      "get": {
        "operationId": "getScenario",
        "tags": ["scenarios"],
        "summary": "Get one Scenario and its ordered production steps.",
        "responses": {
          "200": { "description": "Scenario detail.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Scenario" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenarios/{slug}/attempts": {
      "parameters": [{ "$ref": "#/components/parameters/ScenarioSlug" }],
      "post": {
        "operationId": "startScenarioAttempt",
        "tags": ["scenarios"],
        "summary": "Start a Scenario attempt or resume the current active/paused attempt.",
        "responses": {
          "200": { "description": "Existing attempt resumed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartScenarioAttemptResponse" } } } },
          "201": { "description": "New attempt created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartScenarioAttemptResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenario-attempts/{attemptID}": {
      "parameters": [{ "$ref": "#/components/parameters/ScenarioAttemptID" }],
      "get": {
        "operationId": "getScenarioAttempt",
        "tags": ["scenarios"],
        "summary": "Reload an owned attempt with server-owned progress and current step.",
        "responses": {
          "200": { "description": "Scenario attempt.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioAttempt" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenario-attempts/{attemptID}/pause": {
      "parameters": [{ "$ref": "#/components/parameters/ScenarioAttemptID" }],
      "post": {
        "operationId": "pauseScenarioAttempt",
        "tags": ["scenarios"],
        "summary": "Pause an active attempt using optimistic concurrency.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttemptVersionRequest" } } } },
        "responses": {
          "200": { "description": "Paused attempt.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioAttempt" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenario-attempts/{attemptID}/resume": {
      "parameters": [{ "$ref": "#/components/parameters/ScenarioAttemptID" }],
      "post": {
        "operationId": "resumeScenarioAttempt",
        "tags": ["scenarios"],
        "summary": "Resume a paused attempt using optimistic concurrency.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttemptVersionRequest" } } } },
        "responses": {
          "200": { "description": "Active attempt.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScenarioAttempt" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/scenario-attempts/{attemptID}/steps/{position}": {
      "parameters": [
        { "$ref": "#/components/parameters/ScenarioAttemptID" },
        { "$ref": "#/components/parameters/ScenarioPosition" }
      ],
      "put": {
        "operationId": "submitScenarioStep",
        "tags": ["scenarios"],
        "summary": "Accept one ordered production step and atomically persist its server-judged Recall evidence.",
        "description": "submissionId is an idempotency key. The client cannot select the learning item, rating, submitted answer, correctness, answer-revealed state or judgement. The server resolves the step target, derives objective whole-term evidence, writes a schema-v2 Recall event and advances the attempt in one transaction.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitScenarioStepRequest" } } } },
        "responses": {
          "200": { "description": "Accepted step or idempotent replay.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitScenarioStepResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "ScenarioSlug": { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ScenarioAttemptID": { "name": "attemptID", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "ScenarioPosition": { "name": "position", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 0 } },
      "TimezoneOffsetMinutes": { "name": "timezoneOffsetMinutes", "in": "query", "required": false, "description": "JavaScript Date.getTimezoneOffset used to define the current local day and week.", "schema": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 } }
    },
    "responses": {
      "BadRequest": { "description": "Malformed path parameter or strict JSON body.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Access token is missing or invalid.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Scenario or owned attempt was not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Attempt version, lifecycle, order or idempotency conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationError": { "description": "Production response or evidence is invalid.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InternalError": { "description": "Internal server error.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "ScenarioProgressEnvelope": {
        "type": "object",
        "additionalProperties": true,
        "required": ["scenarios"],
        "properties": {
          "scenarios": { "$ref": "#/components/schemas/ScenarioProgressEvidence" }
        }
      },
      "ScenarioProgressEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completedThisWeek", "completedTotal"],
        "properties": {
          "completedThisWeek": { "type": "integer", "minimum": 0 },
          "completedTotal": { "type": "integer", "minimum": 0 },
          "recommendation": { "$ref": "#/components/schemas/ScenarioProgressRecommendation" }
        }
      },
      "ScenarioProgressRecommendation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "type", "title", "estimatedMinutes", "reason", "action", "completedCount"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["incident", "troubleshooting", "architecture-review", "data-pipeline", "release", "status-update"] },
          "title": { "type": "string", "minLength": 1 },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "enum": ["resume_in_progress", "first_uncompleted", "least_recently_completed"], "description": "Stable server-owned explanation for why this Scenario is the next action." },
          "action": { "type": "string", "enum": ["start", "resume"], "description": "Presentation intent only; the Scenario start endpoint remains authoritative and idempotently resumes an open attempt." },
          "completedCount": { "type": "integer", "minimum": 0 },
          "lastCompletedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ScenarioCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "count"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ScenarioSummary" } },
          "count": { "type": "integer", "minimum": 0 }
        }
      },
      "ScenarioSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "type", "title", "summary", "userRole", "workplaceGoal", "completionCriterion", "constraints", "requiresFactHypothesis", "estimatedMinutes", "version", "stepCount"],
        "properties": {
          "slug": { "type": "string" },
          "type": { "type": "string", "enum": ["incident", "troubleshooting", "architecture-review", "data-pipeline", "release", "status-update"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "userRole": { "type": "string" },
          "workplaceGoal": { "type": "string" },
          "completionCriterion": { "type": "string" },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "requiresFactHypothesis": { "type": "boolean" },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "stepCount": { "type": "integer", "minimum": 1 }
        }
      },
      "Scenario": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "type", "title", "summary", "userRole", "workplaceGoal", "completionCriterion", "constraints", "requiresFactHypothesis", "estimatedMinutes", "version", "stepCount", "steps"],
        "properties": {
          "slug": { "type": "string" },
          "type": { "type": "string", "enum": ["incident", "troubleshooting", "architecture-review", "data-pipeline", "release", "status-update"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "userRole": { "type": "string" },
          "workplaceGoal": { "type": "string" },
          "completionCriterion": { "type": "string" },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "requiresFactHypothesis": { "type": "boolean" },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "stepCount": { "type": "integer", "minimum": 1 },
          "steps": { "type": "array", "items": { "$ref": "#/components/schemas/ScenarioStep" } }
        }
      },
      "ScenarioReviewTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term"],
        "properties": { "term": { "type": "string", "minLength": 1, "description": "Server-owned technical term judged in the production response." } }
      },
      "ScenarioStep": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "kind", "title", "prompt", "productionOutcome", "vocabulary", "reviewTarget", "requiresFactHypothesis", "minResponseCharacters"],
        "properties": {
          "position": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "prompt": { "type": "string" },
          "productionOutcome": { "type": "string" },
          "vocabulary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "reviewTarget": { "$ref": "#/components/schemas/ScenarioReviewTarget" },
          "requiresFactHypothesis": { "type": "boolean" },
          "minResponseCharacters": { "type": "integer", "minimum": 1 }
        }
      },
      "ScenarioAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "currentPosition", "status", "version", "completedPositions", "startedAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "scenario": { "$ref": "#/components/schemas/ScenarioSummary" },
          "currentPosition": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["active", "paused", "completed", "discarded"] },
          "version": { "type": "integer", "format": "int64", "minimum": 1 },
          "completedPositions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "currentStep": { "$ref": "#/components/schemas/ScenarioStep" },
          "startedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "lastSubmission": { "$ref": "#/components/schemas/ScenarioStepSubmission" }
        }
      },
      "ScenarioStepSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "submissionId", "response", "facts", "hypotheses", "reviewEventId", "acceptedAt"],
        "properties": {
          "position": { "type": "integer", "minimum": 0 },
          "submissionId": { "type": "string", "format": "uuid" },
          "response": { "type": "string" },
          "facts": { "type": "array", "items": { "type": "string" } },
          "hypotheses": { "type": "array", "items": { "type": "string" } },
          "reviewEventId": { "type": "integer", "format": "int64", "minimum": 1 },
          "acceptedAt": { "type": "string", "format": "date-time" }
        }
      },
      "StartScenarioAttemptResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "resumed"],
        "properties": { "attempt": { "$ref": "#/components/schemas/ScenarioAttempt" }, "resumed": { "type": "boolean" } }
      },
      "AttemptVersionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attemptVersion"],
        "properties": { "attemptVersion": { "type": "integer", "format": "int64", "minimum": 1 } }
      },
      "ScenarioStepReviewMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "responseMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
          "timezoneOffsetMinutes": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 }
        }
      },
      "SubmitScenarioStepRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submissionId", "attemptVersion", "response"],
        "properties": {
          "submissionId": { "type": "string", "format": "uuid", "description": "Idempotency key for this exact normalized submission." },
          "attemptVersion": { "type": "integer", "format": "int64", "minimum": 1 },
          "response": { "type": "string", "maxLength": 5000 },
          "facts": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 500 } },
          "hypotheses": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 500 } },
          "review": { "$ref": "#/components/schemas/ScenarioStepReviewMetadata" }
        }
      },
      "ReviewResult": {
        "type": "object",
        "additionalProperties": true,
        "required": ["wordId", "status", "easiness", "intervalDays", "repetitions", "dueAt", "lastReviewedAt", "requestedRating", "effectiveRating", "correct", "judgementSource", "judgementReason", "reviewEventId", "suggestionAvailable"],
        "properties": {
          "wordId": { "type": "integer", "format": "int64", "minimum": 1 },
          "status": { "type": "string", "enum": ["new", "learning", "review", "mastered"] },
          "easiness": { "type": "number" },
          "intervalDays": { "type": "integer", "minimum": 0 },
          "repetitions": { "type": "integer", "minimum": 0 },
          "dueAt": { "type": "string", "format": "date-time" },
          "lastReviewedAt": { "type": "string", "format": "date-time" },
          "requestedRating": { "type": "string", "enum": ["again", "almost", "known"] },
          "effectiveRating": { "type": "string", "enum": ["again", "almost", "known"] },
          "correct": { "type": "boolean" },
          "judgementSource": { "type": "string", "const": "server" },
          "judgementReason": { "type": "string", "enum": ["scenario_target_present", "scenario_target_missing"] },
          "matchedAnswer": { "type": "string" },
          "reviewEventId": { "type": "integer", "format": "int64", "minimum": 1 },
          "suggestionAvailable": { "type": "boolean" }
        }
      },
      "SubmitScenarioStepResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "review", "idempotentReplay"],
        "properties": {
          "attempt": { "$ref": "#/components/schemas/ScenarioAttempt" },
          "review": { "$ref": "#/components/schemas/ReviewResult" },
          "idempotentReplay": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    }
  }
}
