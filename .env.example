APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGIN=http://localhost:3000

POSTGRES_DB=lexigo
POSTGRES_USER=lexigo
POSTGRES_PASSWORD=lexigo_local_password
POSTGRES_DSN=postgres://lexigo:lexigo_local_password@postgres:5432/lexigo?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=local-development-secret-change-me-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Local HTTP development requires false. Stage/prod reject false at startup.
SESSION_COOKIE_SECURE=false

# Local/test may log the one-time reset link. Stage/prod require smtp.
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10s

API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_API_BASE_URL=
