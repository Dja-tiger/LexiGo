APP_ENV=stage
APP_DOMAIN=stage.example.com
IMAGE_TAG=main
HTTP_ADDR=:8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGIN=https://stage.example.com
POSTGRES_DB=lexigo_stage
POSTGRES_USER=lexigo_stage
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgres://lexigo_stage:change-me@postgres:5432/lexigo_stage?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0
JWT_SECRET=change-me-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_COOKIE_SECURE=true
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_DELIVERY=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=LexiGo Stage <noreply-stage@example.com>
SMTP_TIMEOUT=10s
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_API_BASE_URL=
CONTENT_SECURITY_POLICY_MODE=report-only
