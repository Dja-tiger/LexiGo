APP_ENV=production
APP_DOMAIN=app.example.com
IMAGE_TAG=sha-or-release-tag
HTTP_ADDR=:8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN=https://app.example.com
POSTGRES_DB=lexigo
POSTGRES_USER=lexigo
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=postgres://lexigo:change-me@postgres:5432/lexigo?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0
JWT_SECRET=change-me-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SESSION_COOKIE_SECURE=true
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_API_BASE_URL=
