# Copy to deploy/openpencil/openpencil.env on the design host and chmod 600.
# Never commit the real file. Values below are placeholders only except the
# immutable OpenPencil image identity, which is repository-approved.

# Resolved from GHCR by OpenPencil self-host workflow run #1 on 2026-08-16.
# OCI index digest; linux/amd64 manifest was sha256:6553c22078f198852a1fc778af7a886e5d941bb5c83f6c1865febf52cb9c7403.
OPENPENCIL_IMAGE=ghcr.io/zseven-w/openpencil-web:v0.8.2@sha256:e13982f18ba3f87ef422c84738be261a337ceccd877aff6ea69a16354fce9775
OPENPENCIL_COMPOSE_PROJECT=lexigo-openpencil

# Dedicated controlled Git worktree. It must be on a non-main design branch.
OPENPENCIL_WORKTREE=/srv/lexigo-design/worktree
OPENPENCIL_STATE_DIR=/srv/lexigo-design/state
OPENPENCIL_BACKUP_DIR=/srv/lexigo-design/backups
OPENPENCIL_UID=1000
OPENPENCIL_GID=1000
OPENPENCIL_BACKUP_KEEP=20

# Web is raw-loopback only; browser users enter through authenticated HTTPS.
OPENPENCIL_WEB_LOOPBACK_PORT=33100
OPENPENCIL_SITE_ADDRESS=design.example.com
OPENPENCIL_WEB_ALLOWED_ORIGINS=https://design.example.com
OPENPENCIL_HTTP_PORT=80
OPENPENCIL_HTTPS_PORT=443
HSTS_MAX_AGE=86400

# MCP is not proxied. Connect locally or through an SSH tunnel to this host
# loopback port. Upstream v0.8.2 itself binds the MCP listener to 127.0.0.1.
OPENPENCIL_MCP_PORT=33101

# Standalone Caddy/Cloudflare TLS. Replace with real host-local values only.
ACME_EMAIL=ops@example.com
CLOUDFLARE_API_TOKEN=REPLACE_ON_HOST
OPENPENCIL_BASIC_AUTH_USER=lexigo-design
# Generate on the host, for example:
#   docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '...'
# If the hash contains '$', single-quote the value in the real env file.
OPENPENCIL_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_HASH
