{
    email {$ACME_EMAIL}
}

(cloudflare_tls) {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
}

(openpencil_security_headers) {
    header {
        Strict-Transport-Security "max-age={$HSTS_MAX_AGE:86400}"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        X-Frame-Options "DENY"
        -Server
    }
}

{$OPENPENCIL_SITE_ADDRESS} {
    import cloudflare_tls
    import openpencil_security_headers
    encode zstd gzip

    # Browser access is authenticated here. The MCP writer is intentionally
    # absent from this proxy and remains host-loopback-only.
    basic_auth {
        {$OPENPENCIL_BASIC_AUTH_USER} {$OPENPENCIL_BASIC_AUTH_HASH}
    }

    reverse_proxy web:3100
}
